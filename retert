local function getHiddenUI()
    local success, result = pcall(function()
        if gethui then
            return gethui()
        elseif get_hidden_gui then
            return get_hidden_gui()
        else
            local hui = CoreGui:FindFirstChild("HUI")
            if not hui then
                hui = Instance.new("Folder")
                hui.Name = "HUI"
                hui.Parent = CoreGui
            end
            return hui
        end
    end)
    return result or CoreGui
end

local function protectInstance(instance)
    local success = pcall(function()
        if protect_gui then
            protect_gui(instance)
        elseif syn and syn.protect_gui then
            syn.protect_gui(instance)
        end
    end)
    if not success then
        pcall(function()
            if set_hidden then
                set_hidden(instance, true)
            end
        end)
    end
end

