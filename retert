                local startY = 40
                local children = container:GetChildren()
                local frames = {}
                for _, child in ipairs(children) do
                    if child:IsA("Frame") and child ~= sectionTitle and child ~= sectionLine then
                        table.insert(frames, child)
                    end
                end
                table.sort(frames, function(a, b)
                    return a.Position.Y.Offset < b.Position.Y.Offset
                end)
                for _, child in ipairs(frames) do
                    child.Position = UDim2.new(child.Position.X.Scale, child.Position.X.Offset, 0, startY)
                    startY = startY + child.Size.Y.Offset + 10
                end
                tabData.YPosition = startY
                tabData.Frame.CanvasSize = UDim2.new(0, 0, 0, startY + 10)
            end

